# Machine-local overrides (untracked; per-host tweaks, secrets like webhooks).
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

# compinit must run before anything that registers completions via `compdef`
# (mise below, omp further down) — otherwise `compdef: command not found`.
autoload -Uz compinit && compinit

# Set up mise for runtime management
eval "$(~/.local/bin/mise activate zsh)"
# mise doesn't ship a completions file on disk; generate it once and cache it.
[[ -f ~/.local/share/mise/completions.zsh ]] || { mkdir -p ~/.local/share/mise; mise completion zsh > ~/.local/share/mise/completions.zsh; }
source ~/.local/share/mise/completions.zsh

# One verb to update everything: pull+apply dotfiles, then upgrade mise itself
# and every mise-managed tool to the newest release. `update -n` previews what
# mise would bump without changing anything.
#   -R/--refresh-externals=always FORCES a git pull of every external (prezto,
#   tpm, and the work overlay) on each `update`. Without it chezmoi honors each
#   external's refreshPeriod (weekly), so a work-overlay edit pushed from another
#   machine could take up to a week to arrive. `update` is the deliberate sync
#   command, so we always refresh; plain `chezmoi apply` still stays fast.
#   mise self-update runs before `mise upgrade` so config.toml settings that
#   only newer mise versions understand don't drift stale on any one machine
#   (this is what broke Linux after a macOS-only mise setting was added).
update() {
    if [[ "$1" == "-n" || "$1" == "--dry-run" ]]; then
        echo "== chezmoi (would apply) =="; chezmoi update --dry-run --verbose
        echo "== mise outdated =="; mise outdated
        return
    fi
    echo "== chezmoi update =="; chezmoi update -R || return
    echo "== mise self-update =="; mise self-update --yes
    echo "== mise upgrade =="; mise upgrade
}

# Helper function for git aliases
function git_main_branch() {
  command git rev-parse --git-dir &>/dev/null || return

  local remote ref

  for ref in refs/{heads,remotes/{origin,upstream}}/{main,trunk,mainline,default,stable,master}; do
    if command git show-ref -q --verify $ref; then
      echo ${ref:t}
      return 0
    fi
  done

  # Fallback: try to get the default branch from remote HEAD symbolic refs
  for remote in origin upstream; do
    ref=$(command git rev-parse --abbrev-ref $remote/HEAD 2>/dev/null)
    if [[ $ref == $remote/* ]]; then
      echo ${ref#"$remote/"}; return 0
    fi
  done

  # If no main branch was found, fall back to master but return error
  echo master
  return 1
}

eval "$(omp completions zsh)"

{{ if and .work (eq .chezmoi.os "linux") -}}
# zmx — session persistence. Installed only on the remote dev desktop (see
# mise/config.toml.tmpl), so this whole block is gated on the same predicate
# rather than leaning on the `command -v` guards alone.
# zmx
if command -v zmx &> /dev/null; then
  eval "$(zmx completions zsh)"
fi

# prefix every session name with d. (so `zmx a term` -> session d.term)
export ZMX_SESSION_PREFIX="d."

zmx-select() {
  local display
  local prefix="${ZMX_SESSION_PREFIX:-}"
  display=$(zmx list 2>/dev/null | while IFS=$'\t' read -r name pid clients created dir; do
    name=${name#*name=}
    pid=${pid#*pid=}
    clients=${clients#*clients=}
    dir=${dir#*start_dir=}
    if [[ -n "$prefix" ]]; then
      [[ "$name" == "$prefix"* ]] || continue
      name=${name#"$prefix"}
    fi
    printf "%-20s  pid:%-8s  clients:%-2s  %s\n" "$name" "$pid" "$clients" "$dir"
  done)

  local output query key selected session_name
  output=$({ [[ -n "$display" ]] && echo "$display"; } | fzf \
    --print-query \
    --expect=ctrl-n \
    --height=80% \
    --reverse \
    --prompt="zmx> " \
    --header="Enter: select | Ctrl-N: create new" \
    --preview='zmx history {1}' \
    --preview-window=right:60%:follow \
  )
  local rc=$?

  query=$(echo "$output" | sed -n '1p')
  key=$(echo "$output" | sed -n '2p')
  selected=$(echo "$output" | sed -n '3p')

  if [[ "$key" == "ctrl-n" && -n "$query" ]]; then
    session_name="$query"
  elif [[ $rc -eq 0 && -n "$selected" ]]; then
    session_name=$(echo "$selected" | awk '{print $1}')
  elif [[ -n "$query" ]]; then
    session_name="$query"
  else
    return 130
  fi

  zmx attach "$session_name"
}

# optional: land in the picker on shell start when not already in a session
if command -v zmx &> /dev/null && command -v fzf &> /dev/null && [[ -z "$ZMX_SESSION" ]]; then
  zmx-select && exit
fi
